# AXE Dispatch - Docker Compose environment template
# Copy this file to .env and replace every CHANGE_ME value before starting.
# Never commit the resulting .env file.

APP_PORT=3000

# MySQL
MYSQL_DATABASE=central_alertas
MYSQL_USER=alertas
MYSQL_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Application security
# JWT_SECRET must satisfy the runtime security policy. Prefer 32+ random bytes.
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
LOCAL_AUTH_BOOTSTRAP_USERNAME=admin
LOCAL_AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_USE_AT_LEAST_12_CHARACTERS

# Reverse proxy. Keep false unless a trusted reverse proxy is explicitly deployed.
TRUST_PROXY=false

# ALRT ingress is disabled by default.
ALRT_INGRESS_MODE=desativado
ALRT_INGRESS_API_KEY=
ALRT_INGRESS_HMAC_SECRET=
ALRT_TIMESTAMP_TOLERANCE_SECONDS=300
ALRT_RATE_LIMIT=60
