# Dispatch - Docker environment template
# Copy to .env and replace every CHANGE_ME value before production use.

# Application
APP_PORT=3000
PORT=3000
NODE_ENV=production

# MySQL used by docker-compose.yml
MYSQL_DATABASE=dispatch
MYSQL_USER=dispatch
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Application security - use a long random value (32+ bytes recommended)
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_32_BYTES_MINIMUM

# Local bootstrap administrator
LOCAL_AUTH_BOOTSTRAP_USERNAME=admin
LOCAL_AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_MINIMUM_12_CHARACTERS

# Optional OAuth / application identity
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Motor de Ativos / Inventário (optional; Dispatch remains operational when unavailable)
ASSET_INVENTORY_BASE_URL=
ASSET_INVENTORY_WEB_URL=
ASSET_INVENTORY_TENANT_ID=
ASSET_INVENTORY_TIMEOUT_MS=3000

# External inventory homologation adapter.
# Keep disabled in production. When enabled outside production, use a temporary 24+ byte key.
ASSET_INVENTORY_HOMOLOGATION_ENABLED=false
ASSET_INVENTORY_HOMOLOGATION_API_KEY=

# Optional built-in Forge integration
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional storage health check
STORAGE_HEALTHCHECK_KEY=

# ALRT ingress (disabled by default)
ALRT_INGRESS_MODE=desativado
ALRT_INGRESS_API_KEY=
ALRT_INGRESS_HMAC_SECRET=
ALRT_TIMESTAMP_TOLERANCE_SECONDS=300
ALRT_RATE_LIMIT=60

# Set true only when running behind exactly one trusted reverse-proxy hop
TRUST_PROXY=false
