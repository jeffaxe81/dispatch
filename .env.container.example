# Copy this file to `.env` for local development with docker-compose.
# For production, keep secrets in a separate, restricted-permission file
# outside the repository (see docs/deploy-docker.md) and never commit it.

# --- Application -------------------------------------------------------
NODE_ENV=production
PORT=3000
# Trust exactly one reverse proxy hop (set true only behind a single
# trusted TLS-terminating proxy such as Nginx/Caddy).
TRUST_PROXY=false

# Session signing secret. Generate with: openssl rand -base64 48
# Must be at least 32 random bytes; never reuse the example below.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Database (MySQL 8 compatible) --------------------------------------
# docker-compose builds DATABASE_URL from these for the bundled mysql
# service. For an external/managed database, set DATABASE_URL directly
# instead and remove the mysql service from docker-compose.yml.
MYSQL_DATABASE=axe_dispatch
MYSQL_USER=axe_dispatch
MYSQL_PASSWORD=axe_dispatch_dev
MYSQL_ROOT_PASSWORD=axe_dispatch_root_dev
# DATABASE_URL=mysql://user:password@host:3306/database

# --- Initial administrator bootstrap ------------------------------------
# Created automatically on first boot if no user with this username exists.
LOCAL_AUTH_BOOTSTRAP_USERNAME=admin
LOCAL_AUTH_BOOTSTRAP_PASSWORD=troque-por-uma-senha-forte-de-12-caracteres

# Optional: grants an extra super-administrator override to the user with
# this openId (the bootstrap admin's openId is "local:<username>" above).
# Leave unset unless you need this extra guarantee.
# OWNER_OPEN_ID=local:admin

# --- Evidence / profile-photo storage (S3-compatible) -------------------
# Works with AWS S3 or any compatible service (MinIO, etc). The bundled
# docker-compose "minio" service is for local development only.
STORAGE_S3_BUCKET=axe-dispatch-evidencias
STORAGE_S3_ACCESS_KEY_ID=axe_dispatch_dev
STORAGE_S3_SECRET_ACCESS_KEY=axe_dispatch_dev_secret
# Required for MinIO or any non-AWS S3-compatible endpoint. Omit both for
# managed AWS S3 and set STORAGE_S3_REGION to your bucket's region instead.
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_REGION=us-east-1
