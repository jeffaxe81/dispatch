# This file is SEPARATE from the Dispatch .env file.
# Copy to .env.alerts; generate secrets, never commit the populated file.
ALERTS_MYSQL_DATABASE=central_alertas
ALERTS_MYSQL_USER=alertas
ALERTS_MYSQL_PASSWORD=CHANGE_ME_ALERTS_DB_PASSWORD
ALERTS_MYSQL_ROOT_PASSWORD=CHANGE_ME_ALERTS_ROOT_PASSWORD
ALERTS_JWT_SECRET=CHANGE_ME_ALERTS_INDEPENDENT_LONG_RANDOM_SECRET
# Listen only on host loopback unless explicitly exposed via authenticated proxy.
ALERTS_PORT=3003
# Optional for development/offline packaging:
# ALERTS_BUILD_CONTEXT=./.modules/alerts
